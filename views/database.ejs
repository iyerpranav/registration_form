<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Database</title>
  <link rel="stylesheet" href="/styles/styles3.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
    rel="stylesheet">
</head>

<body>
  <header>
    <h1>Registered Users</h1>
    <div class="hamburger">
      <img src="/images/burger_menu.svg" width="40px">
      <div id="menu" class="dropdown">
        <a href="/admin/product/newproduct">Products</a>
        <a href="/admin/index/logout">Logout</a>
      </div>
    </div>
  </header>

  <div id="table-holder">
    <table>
      <thead>
        <tr>
          <th></th>
          <th></th>
          <% cols.forEach(function(colname) { %>
            <th><%= colname %></th>
          <% }) %>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(function(user) { %>
          <tr>
            <td>
              <form action="/admin/<%= table %>/update/<%= user.id %>" method="GET">
                <button type="submit" class="upd">U
                  <p class="tooltip">Update</p>
                </button>
              </form>
            </td>
            <td>
              <form action="/admin/<%= table %>/delete/<%= user.id %>?_method=DELETE" method="POST">
                <button type="submit" class="del">D
                  <p class="tooltip">Delete</p>
                </button>
              </form>
            </td>
            <td>
              <%= user.id %>
            </td>
            <td>
              <%= user.fname %>
            </td>
            <td>
              <%= user.lname %>
            </td>
            <td>
              <%= user.email %>
            </td>
            <td>
              <%= user.password_hash %>
            </td>
            <td>
              <%= user.mobile %>
            </td>
            <td>
              <%= user.dob %>
            </td>
            <td>
              <%= user.gender %>
            </td>
            <td>
              <%= user.address %>
            </td>
            <td>
              <%= user.country %>
            </td>
            <td>
              <%= user.postal_code %>
            </td>
            <td>
              <%= user.created_at %>
            </td>
            <td>
              <%= user.role %>
            </td>
          </tr>
          <% }) %>
      </tbody>
    </table>
  </div>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="/scripts/script1.js"></script>
</body>

</html>