<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Database</title>
    <link rel="stylesheet" href="/styles/styles5.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
</head>

<body>
    <header>
        <h1>Listed Products</h1>
        <div class="hamburger">
            <img src="/images/burger_menu.svg" width="40px">
            <div id="menu" class="dropdown">
                <a href="/admin/users/database">Users</a>
                <a href="/admin/index/logout">Logout</a>
            </div>
        </div>
    </header>

    <div class="form_body">

        <form action="/admin/addproduct" method="POST" enctype="multipart/form-data">
            <input type="text" name="name" placeholder="Product Name" required>
            <input type="text" name="code" placeholder="Product Code" required>
            <input type="number" name="rate" step="0.01" placeholder="Product Rate" required>

            <select name="status" required>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>

            <select name="category_id" required>
                <% categories.forEach(cat=> { %>
                    <option value="<%= cat.id %>">
                        <%= cat.name %>
                    </option>
                    <% }) %>
            </select>

            <textarea name="description" placeholder="Product Description"></textarea>
            <input type="file" name="image" accept="image/*" required>
            <input type="submit" value="Add Product">
        </form>
    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="/scripts/script1.js"></script>
</body>

</html>